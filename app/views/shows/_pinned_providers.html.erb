<%# locals: (providers:) %>

<div class="pinned-providers" data-test-id="pinned-providers">
  <span class="pinned-providers__pin" aria-hidden="true">📌</span>

  <% providers.each do |provider| %>
    <% if provider.logo.url %>
      <%= image_tag provider.logo.url, alt: provider.name, class: "pinned-providers__logo", loading: "lazy" %>
    <% else %>
      <span class="pinned-providers__name"><%= provider.name %></span>
    <% end %>
  <% end %>
</div>
