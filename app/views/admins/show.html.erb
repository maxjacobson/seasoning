<% content_for :title do %>
  Admin
<% end %>

<div class="page">
  <h1 class="page__title">Admin</h1>

  <div class="admin-sections">
    <div class="admin-panel">
      <h2 class="section-heading">Stats</h2>

      <ul class="admin-list">
        <li>
          <strong>Humans count:</strong> <%= number_with_delimiter(Human.count) %>
        </li>

        <li>
          <strong>Shows count:</strong> <%= number_with_delimiter(Show.count) %>
        </li>

        <li>
          <strong>Seasons count:</strong> <%= number_with_delimiter(Season.count) %>
        </li>

        <li>
          <strong>Reviews count:</strong> <%= number_with_delimiter(SeasonReview.count) %>
        </li>

        <li>
          <strong>Episodes count:</strong> <%= number_with_delimiter(Episode.count) %>
        </li>

        <% orphaned_shows = Show.where(orphaned: true) %>

        <% if orphaned_shows.any? %>
          <li>
            <strong>Orphaned shows count:</strong>
            <%= number_with_delimiter(orphaned_shows.count) %>

            <ul class="admin-list admin-list--nested">
              <% orphaned_shows.each do |show| %>
                <li><%= link_to show.title, show_path(show.slug) %></li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <% orphaned_seasons = Season.where(orphaned: true).includes(:show) %>

        <% if orphaned_seasons.any? %>
          <li>
            <strong>Orphaned seasons count:</strong>
            <%= number_with_delimiter(orphaned_seasons.count) %>

            <ul class="admin-list admin-list--nested">
              <% orphaned_seasons.each do |season| %>
                <li>
                  <%= link_to "#{season.show.title} - #{season.name}", season_path(season.show.slug, season.slug) %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <li>
          <strong>Last refreshed TMDB config:</strong>
          <% fetched_at = TMDBAPIConfiguration.sole.fetched_at %>
          <time datetime="<%= fetched_at.iso8601 %>"><%= time_ago_in_words(fetched_at) %> ago</time>
        </li>
      </ul>
    </div>

    <div class="admin-panel">
      <h2 class="section-heading">Recent humans</h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Human</th>
            <th>Shows added</th>
            <th>Reviews</th>
            <th>Last active</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% Human.with_last_active_at.order(created_at: :desc).limit(50).each do |human| %>
            <tr>
              <td>
                <%= link_to human.handle, human_profile_path(human.handle) %>
              </td>

              <td>
                <%= number_with_delimiter(human.added_shows_count) %>
              </td>

              <td>
                <%= number_with_delimiter(human.season_reviews_count) %>
              </td>

              <td class="admin-table__last-active">
                <% if human.last_active_at %>
                  <time datetime="<%= human.last_active_at.iso8601 %>"><%= time_ago_in_words(human.last_active_at) %> ago</time>
                <% else %>
                  Joined
                  <time datetime="<%= human.created_at.iso8601 %>"><%= time_ago_in_words(human.created_at) %> ago</time>
                <% end %>
              </td>

              <td>
                <% if current_human != human && !human.added_shows? %>
                  <%= button_to "Delete",
                    admin_human_path(human),
                    method: :delete,
                    class: "link-looking-button",
                    form_class: "inline",
                    data: { turbo_confirm: "Are you sure you want to delete #{human.handle}? This cannot be undone." } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
